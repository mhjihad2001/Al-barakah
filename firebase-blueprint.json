{
  "entities": {
    "GeneralSettings": {
      "title": "GeneralSettings",
      "description": "Public restaurant configuration, status mode, WhatsApp settings, and Meta Pixel settings (no private secrets).",
      "type": "object",
      "properties": {
        "brandName": { "type": "string", "minLength": 1, "maxLength": 120 },
        "heritageOrigin": { "type": "string", "maxLength": 200 },
        "logoUrl": { "type": "string", "maxLength": 500 },
        "whatsappNumber": { "type": "string", "minLength": 8, "maxLength": 25 },
        "whatsappRedirectEnabled": { "type": "boolean" },
        "displayPhone": { "type": "string", "maxLength": 30 },
        "email": { "type": "string", "maxLength": 120 },
        "address": { "type": "string", "maxLength": 300 },
        "hoursDisplay": { "type": "string", "maxLength": 120 },
        "openHour": { "type": "number" },
        "openMinute": { "type": "number" },
        "closeHour": { "type": "number" },
        "closeMinute": { "type": "number" },
        "statusMode": { "type": "string", "enum": ["auto", "open", "preorder"] },
        "isOpen": { "type": "boolean" },
        "adminPin": { "type": "string", "minLength": 4, "maxLength": 20 },
        "mapsCoordinates": { "type": "string", "maxLength": 80 },
        "mapsUrl": { "type": "string", "maxLength": 500 },
        "facebookUrl": { "type": "string", "maxLength": 500 },
        "instagramUrl": { "type": "string", "maxLength": 500 },
        "metaEnabled": { "type": "boolean" },
        "metaPixelId": { "type": "string", "maxLength": 30 },
        "capiEnabled": { "type": "boolean" },
        "metaTestEventCode": { "type": "string", "maxLength": 40 },
        "metaDebugConsole": { "type": "boolean" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "brandName",
        "whatsappNumber",
        "whatsappRedirectEnabled",
        "statusMode",
        "metaEnabled",
        "metaPixelId",
        "capiEnabled"
      ]
    },
    "SiteContent": {
      "title": "SiteContent",
      "description": "Editable storefront page copy across Navbar, Hero, Signature Heritage, Menu, Catering, Reviews, and Footer.",
      "type": "object",
      "properties": {
        "navbar": { "type": "object" },
        "hero": { "type": "object" },
        "heritage": { "type": "object" },
        "menu": { "type": "object" },
        "catering": { "type": "object" },
        "reviews": { "type": "object" },
        "footer": { "type": "object" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["navbar", "hero", "heritage", "menu", "catering", "reviews", "footer"]
    },
    "SecretSettings": {
      "title": "SecretSettings",
      "description": "Admin-only private integration credentials such as Meta CAPI Access Token.",
      "type": "object",
      "properties": {
        "capiAccessToken": { "type": "string", "maxLength": 512 },
        "capiEndpointUrl": { "type": "string", "maxLength": 500 },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["capiAccessToken"]
    },
    "MenuItem": {
      "title": "MenuItem",
      "description": "A restaurant dish displayed in the interactive Bengali menu.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 140 },
        "category": {
          "type": "string",
          "enum": ["স্পেশাল কাচ্চি ও তেহারি", "কাবাব ও স্টার্টার", "ডেজার্ট ও পানীয়"]
        },
        "description": { "type": "string", "maxLength": 600 },
        "servingSize": { "type": "string", "maxLength": 80 },
        "price": { "type": "number" },
        "image": { "type": "string", "maxLength": 500 },
        "available": { "type": "boolean" },
        "preOrderOnly": { "type": "boolean" },
        "advanceNotice": { "type": "string", "maxLength": 160 },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "name", "category", "price", "available", "preOrderOnly", "sortOrder"]
    },
    "DeliveryZone": {
      "title": "DeliveryZone",
      "description": "A delivery coverage zone with fee and estimated delivery time.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fee": { "type": "number" },
        "eta": { "type": "string", "maxLength": 80 },
        "isOutOfArea": { "type": "boolean" },
        "note": { "type": "string", "maxLength": 300 },
        "sortOrder": { "type": "number" }
      },
      "required": ["id", "name", "fee", "eta", "isOutOfArea", "sortOrder"]
    },
    "Order": {
      "title": "Order",
      "description": "Full customer order document containing PII (strictly restricted to Admin reads).",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 4, "maxLength": 40 },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 120 },
        "customerPhone": { "type": "string", "minLength": 8, "maxLength": 25 },
        "deliveryZone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "fullAddress": { "type": "string", "maxLength": 400 },
        "orderType": { "type": "string", "enum": ["instant", "preorder"] },
        "preorderDate": { "type": "string", "maxLength": 20 },
        "preorderTimeSlot": { "type": "string", "maxLength": 60 },
        "items": { "type": "array", "description": "Line items ordered by the customer (1-30 items)." },
        "subtotal": { "type": "number" },
        "deliveryCharge": { "type": "number" },
        "grandTotal": { "type": "number" },
        "status": { "type": "string", "enum": ["pending", "preparing", "out_for_delivery", "completed"] },
        "metaEventId": { "type": "string", "maxLength": 80 },
        "fbp": { "type": "string", "maxLength": 160 },
        "fbc": { "type": "string", "maxLength": 240 },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId",
        "customerName",
        "customerPhone",
        "deliveryZone",
        "fullAddress",
        "orderType",
        "preorderDate",
        "preorderTimeSlot",
        "items",
        "subtotal",
        "deliveryCharge",
        "grandTotal",
        "status",
        "metaEventId",
        "fbp",
        "fbc",
        "createdAt"
      ]
    },
    "OrderTracking": {
      "title": "OrderTracking",
      "description": "Non-PII public projection of order status for the Order Tracking Popup.",
      "type": "object",
      "properties": {
        "orderId": { "type": "string", "minLength": 4, "maxLength": 40 },
        "status": { "type": "string", "enum": ["pending", "preparing", "out_for_delivery", "completed"] },
        "orderType": { "type": "string", "enum": ["instant", "preorder"] },
        "deliveryZone": { "type": "string", "minLength": 1, "maxLength": 100 },
        "preorderDate": { "type": "string", "maxLength": 20 },
        "preorderTimeSlot": { "type": "string", "maxLength": 60 },
        "itemCount": { "type": "number" },
        "grandTotal": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": [
        "orderId",
        "status",
        "orderType",
        "deliveryZone",
        "preorderDate",
        "preorderTimeSlot",
        "itemCount",
        "grandTotal",
        "createdAt",
        "updatedAt"
      ]
    },
    "PhoneOrderIndex": {
      "title": "PhoneOrderIndex",
      "description": "SHA-256 phone-hash lookup mapping to non-PII tracking document IDs.",
      "type": "object",
      "properties": {
        "latestOrderId": { "type": "string", "minLength": 4, "maxLength": 64, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderIds": { "type": "array", "description": "Recent order tracking document IDs (max 30)." },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["latestOrderId", "orderIds", "updatedAt"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Authorized admin UID registry.",
      "type": "object",
      "properties": {
        "email": { "type": "string", "maxLength": 120 },
        "role": { "type": "string", "enum": ["admin"] }
      },
      "required": ["email", "role"]
    }
  },
  "firestore": {
    "/settings/general": {
      "schema": { "$ref": "#/entities/GeneralSettings" },
      "description": "Public general restaurant settings, live status, WhatsApp, and Meta Pixel configuration."
    },
    "/settings/site_content": {
      "schema": { "$ref": "#/entities/SiteContent" },
      "description": "Public editable page copy across all storefront sections (Navbar, Hero, Heritage, Menu, Catering, Reviews, Footer)."
    },
    "/settings/secrets": {
      "schema": { "$ref": "#/entities/SecretSettings" },
      "description": "Admin-only private CAPI access token and endpoint settings."
    },
    "/menu_items/{itemId}": {
      "schema": { "$ref": "#/entities/MenuItem" },
      "description": "Real-time restaurant menu items ordered by sortOrder."
    },
    "/delivery_zones/{zoneId}": {
      "schema": { "$ref": "#/entities/DeliveryZone" },
      "description": "Real-time delivery zones, fees, and estimated delivery times."
    },
    "/orders/{orderDocId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders with PII and Meta CAPI metadata (admin read/update only)."
    },
    "/order_tracking/{trackingId}": {
      "schema": { "$ref": "#/entities/OrderTracking" },
      "description": "Non-PII public order tracking projection readable by exact order tracking ID."
    },
    "/phone_order_index/{phoneHash}": {
      "schema": { "$ref": "#/entities/PhoneOrderIndex" },
      "description": "Non-PII SHA-256 phone hash index mapping to tracking document IDs."
    },
    "/admins/{uid}": {
      "schema": { "$ref": "#/entities/AdminUser" },
      "description": "Admin role allowlist."
    }
  }
}
